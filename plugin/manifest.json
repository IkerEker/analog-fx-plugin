{
  "manifestVersion": 5,
  "id": "com.ikereker.analogfx",
  "name": "Analog FX",
  "version": "0.7.4",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "plugin"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "analogfxPanel",
      "label": { "default": "Analog FX" },
      "minimumSize": { "width": 230, "height": 300 },
      "maximumSize": { "width": 2400, "height": 6000 },
      "preferredDockedSize": { "width": 300, "height": 680 },
      "preferredFloatingSize": { "width": 320, "height": 720 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["generic"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
